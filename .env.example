# PostgreSQL connection used by FastAPI and Alembic.
DATABASE_URL=postgresql+psycopg://acxiomcrm:change-me@localhost:5432/acxiomcrm

# Generate a long, random value per environment. Never commit a real value.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
APP_ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173
